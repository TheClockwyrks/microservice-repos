# The environment of a local `tcab-repos` (cargo run --bin tcab-repos). Copy it
# to `.env.repos` beside where the binary runs, which it reads at startup; a
# variable already set in the environment wins. Every variable is documented in
# crates/repos/src/config.rs.

# The address the service binds.
TCAB_REPOS_BIND=127.0.0.1:8792

# The backend the per-job and per-publish-job tokens are verified against, and
# the service token the backend presents for a download and a delete, which a
# publish also reads the run's record with.
TCAB_BACKEND_URL=http://127.0.0.1:8787
TCAB_BACKEND_SERVICE_TOKEN=

# The private bundle container. Against Azurite (`npx azurite-blob`), its
# well-known account and key with the path-style endpoint; in a cluster leave
# the endpoint and key unset, and the pod's workload identity signs instead.
TCAB_REPOS_BLOB_ACCOUNT=devstoreaccount1
TCAB_REPOS_BLOB_CONTAINER=bundles
TCAB_REPOS_BLOB_ENDPOINT=http://127.0.0.1:10000/devstoreaccount1
TCAB_REPOS_BLOB_KEY=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==

# The organization a published run's repository is created under and the
# token that creates and pushes it. Leave both unset to refuse every publish.
TCAB_GITHUB_ORG=
TCAB_GITHUB_TOKEN=
